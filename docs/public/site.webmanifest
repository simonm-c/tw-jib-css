{
  "name": "Jibcss",
  "short_name": "Jibcss",
  "description": "TailwindCSS v4 utility library: border gradients, color transforms and ripple effects.",
  "id": "/tw-jib-css/",
  "start_url": "/tw-jib-css/",
  "scope": "/tw-jib-css/",
  "display": "standalone",
  "theme_color": "#05121d",
  "background_color": "#05121d",
  "icons": [
    {
      "src": "/tw-jib-css/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tw-jib-css/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/tw-jib-css/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
