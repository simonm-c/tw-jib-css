{
  "name": "tw-jib-css-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for tw-jib-css and tw-jib-css-experimental. Publishes nothing; the packages under packages/ do.",
  "type": "module",
  "license": "MIT",
  "author": "Simon Monk-Chipman",
  "homepage": "https://github.com/simonm-c/tw-jib-css#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonm-c/tw-jib-css.git"
  },
  "bugs": {
    "url": "https://github.com/simonm-c/tw-jib-css/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:css": "vitest run tests/css",
    "test:integration": "playwright test",
    "dev:docs": "vitepress dev docs",
    "dev:docs:experimental": "vitepress dev docs-experimental --port 5174",
    "build:docs": "vitepress build docs",
    "build:docs:experimental": "vitepress build docs-experimental",
    "build:llm-docs": "tsx scripts/build-llm-docs.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^3.2.0"
  }
}
