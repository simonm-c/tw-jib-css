{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./docs-shared/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "docs/.vitepress/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
